# Optional: Gemini API key for AI campaign synthesis.
# Without it, AdGen uses a deterministic copy engine.
# GEMINI_API_KEY=

# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Server port (default 3000)
# PORT=3000

# Public URL of this deployment (optional metadata)
APP_URL="http://localhost:3000"
